SERVER_PORT=8080
DATABASE_URL=postgres://spo:spo@localhost:5432/spo
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Webhook secrets untuk provider simulator
WEBHOOK_SECRET_ALPHA=alpha-secret-dev
WEBHOOK_SECRET_BETA=beta-secret-dev
WEBHOOK_SECRET_GAMMA=gamma-secret-dev

# Retry & Circuit Breaker
MAX_RETRY_ATTEMPTS=5
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30