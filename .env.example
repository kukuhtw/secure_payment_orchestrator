SERVER_PORT=8126
DATABASE_URL=postgres://spo:spo@localhost:5432/spo
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Gamma dipetakan ke DOKU Sandbox.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_TIMEOUT_SECONDS=10

# NICEPAY Sandbox example (Professional/Checkout v1).
NICEPAY_IMID=
NICEPAY_MERCHANT_KEY=
NICEPAY_BASE_URL=https://dev.nicepay.co.id
NICEPAY_PAY_METHOD=01
NICEPAY_TIMEOUT_SECONDS=10

# Alpha dipetakan ke Midtrans Sandbox.
# Jangan commit Server Key asli. Ambil dari Midtrans Dashboard > Settings > Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_CORE_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_TIMEOUT_SECONDS=10

# Beta dipetakan ke Xendit test mode. Gunakan Secret API Key dan callback token test.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_TIMEOUT_SECONDS=10

# Retry & Circuit Breaker
MAX_RETRY_ATTEMPTS=5
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
